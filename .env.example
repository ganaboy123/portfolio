# ── NOVA AI Engine Configuration ─────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Without an API key, NOVA runs in local mode (portfolio Q&A only).
# With an API key, NOVA becomes a full AI assistant (any topic).

# OpenAI API key — get one at https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=sk-...

# Model to use (default: gpt-4o-mini — fast, cheap, capable)
# Options: gpt-4o-mini | gpt-4o | gpt-3.5-turbo
VITE_OPENAI_MODEL=gpt-4o-mini

# Optional: point to any OpenAI-compatible API (Groq, Together, Ollama, etc.)
# VITE_OPENAI_BASE_URL=https://api.groq.com/openai/v1
